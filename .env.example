GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REFRESH_TOKEN=YOUR_GOOGLE_REFRESH_TOKEN

# Backblaze B2 Configuration
B2_APP_KEY_ID=YOUR_B2_APP_KEY_ID
B2_APP_KEY=YOUR_B2_APP_KEY
B2_BUCKET_ID=YOUR_B2_BUCKET_ID
B2_BUCKET_NAME=YOUR_B2_BUCKET_NAME
B2_DOWNLOAD_URL=https://f002.backblazeb2.com

# Performance Tuning (Optional - defaults are safe for most use cases)
PLAYLIST_CONCURRENCY=3        # How many playlists to process at once
THUMBNAIL_CONCURRENCY=10      # How many thumbnails to download at once
BATCH_CONCURRENCY=3           # How many API batches to fetch at once
